{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json -w",
    "dev": "concurrently -k \"npm run dev:react\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "start:electron": "wait-on tcp:5173 && electron .",
    "dev:full": "concurrently -k \"npm run dev:react\" \"npm run dev:electron\" \"npm run start:electron\"",
    "build:react": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:react && npm run build:electron && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "oxlint": "^1.75.0",
    "tree-kill": "^1.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
